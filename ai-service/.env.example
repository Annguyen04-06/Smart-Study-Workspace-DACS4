# Cấu hình mẫu cho AI Microservice (FastAPI - Port 8000)
# Sao chép thành tệp .env và điền khóa API thực tế (hỗ trợ cả AQ.* Vertex Express & AIza* AI Studio)
APP_NAME="Smart Study AI Microservice"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

INTERNAL_API_KEY="smartstudy-internal-secret-key-2026"
MAX_PDF_SIZE_MB=25
MAX_CONTEXT_CHARS=48000
CORS_ORIGINS="http://localhost:5000,http://localhost:5500,http://127.0.0.1:5500"
