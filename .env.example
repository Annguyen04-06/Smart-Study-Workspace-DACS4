# =============================================================================
# Smart Study Workspace — Biến Môi Trường Triển Khai (Environment Variables)
# =============================================================================

# Google Gemini API Key (Bắt buộc để kích hoạt Trợ giảng AI bám sát giáo trình)
GEMINI_API_KEY=your_gemini_api_key_here

# Khóa bí mật giao tiếp nội bộ giữa Backend C# và AI Service Python
INTERNAL_API_KEY=smartstudy-internal-secret-key-2026

# Mật khẩu quản trị cơ sở dữ liệu SQL Server (Dùng cho Docker Compose)
MSSQL_SA_PASSWORD=YourStrong@Passw0rd!
